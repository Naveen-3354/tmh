{
  "name": "@tmh/mcp-stdio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP server for tmh. Point Claude Desktop or any stdio MCP client at the built binary.",
  "bin": {
    "tmh-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tmh/db": "*",
    "@tmh/mcp-core": "*",
    "@tmh/shared": "*",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.19.2"
  }
}
