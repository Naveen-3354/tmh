# ---------------------------------------------------------------------------
# Copy this to apps/web/.env.local and fill it in. Never commit that file.
#
#   cp .env.example apps/web/.env.local
#
# It lives under apps/web because that is where Next.js looks — it does not
# read .env files from a monorepo root. The database scripts in packages/db
# read the same file, so there is still only one place to edit.
#
# In production these are set in the Vercel dashboard, not from a file.
# ---------------------------------------------------------------------------

# --- Supabase auth --------------------------------------------------------
# Project Settings -> API. The publishable/anon key is safe to expose to the
# browser: every table is protected by row-level security, so it grants
# nothing on its own without a valid user session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# --- Database -------------------------------------------------------------
# SECRET. Project Settings -> Database -> Connection string -> URI.
#
# All application queries run through this connection, and every one of them
# is wrapped in a transaction that drops to the `authenticated` role so
# Postgres RLS applies. See packages/db/src/client.ts.
#
# Use the *transaction pooler* host (port 6543) for the app — serverless
# functions exhaust direct connections quickly:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional. Direct connection (port 5432), used only by `npm run db:migrate`,
# which needs to run DDL. Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=

# --- App ------------------------------------------------------------------
# Used to build absolute URLs for auth redirects (magic links, OAuth).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo account (optional) ----------------------------------------------
# Populated by `npm run db:seed`. Enables a one-click "Explore the demo"
# button on the sign-in page so stakeholders can look around without an
# inbox. Credentials stay server-side; only the boolean reaches the browser.
# Leave NEXT_PUBLIC_DEMO_ENABLED unset to hide the button entirely.
NEXT_PUBLIC_DEMO_ENABLED=false
DEMO_EMAIL=demo@tmh.app
DEMO_PASSWORD=demo-tmh-2026

# --- Food catalogue (optional) --------------------------------------------
# Free key from https://fdc.nal.usda.gov/api-key-signup.html. Without it,
# USDA search falls back to their shared DEMO_KEY, which works but is
# aggressively rate limited. Open Food Facts needs no key.
USDA_API_KEY=

# --- Photo food recognition (optional) ------------------------------------
# Leave GEMINI_API_KEY unset and photo identification is simply absent — the
# camera still does on-device barcode scanning, which needs no key and sends
# nothing but the barcode number.
#
# Setting it enables photo identification *as an option*; each user must also
# opt in under Settings, because sending a photograph to a third party is a
# deliberate exception to the "query terms only" rule in the brief (§8).
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override only if the default model name stops being available.
GEMINI_MODEL=
