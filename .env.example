# ---------------------------------------------------------------------------
# Copy this to apps/web/.env.local and fill it in. Never commit that file.
#
#   cp .env.example apps/web/.env.local
#
# It lives under apps/web because that is where Next.js looks — it does not
# read .env files from a monorepo root. The database scripts in packages/db
# read the same file, so there is still only one place to edit.
#
# In production these are set in the Vercel dashboard, not from a file.
# ---------------------------------------------------------------------------

# --- Supabase auth --------------------------------------------------------
# Project Settings -> API. The publishable/anon key is safe to expose to the
# browser: every table is protected by row-level security, so it grants
# nothing on its own without a valid user session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# --- Database -------------------------------------------------------------
# SECRET. Project Settings -> Database -> Connection string -> URI.
#
# All application queries run through this connection, and every one of them
# is wrapped in a transaction that drops to the `authenticated` role so
# Postgres RLS applies. See packages/db/src/client.ts.
#
# Use the *transaction pooler* host (port 6543) for the app — serverless
# functions exhaust direct connections quickly:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional. Direct connection (port 5432), used only by `npm run db:migrate`,
# which needs to run DDL. Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=

# --- App ------------------------------------------------------------------
# Used to build absolute URLs for auth redirects (magic links, OAuth).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
