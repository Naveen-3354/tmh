# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project Settings -> API. The anon key is safe to expose to the browser:
# every table is protected by row-level security, so it grants nothing on its
# own without a valid user session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- App ------------------------------------------------------------------
# Used to build absolute URLs for auth redirects (magic links, OAuth).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
