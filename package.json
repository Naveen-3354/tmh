{
  "name": "tmh",
  "version": "0.1.0",
  "private": true,
  "description": "Personal health and daily activity tracker with an MCP server",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w @tmh/web",
    "build": "npm run build -w @tmh/web",
    "start": "npm run start -w @tmh/web",
    "lint": "npm run lint -w @tmh/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @tmh/db",
    "db:migrate": "npm run push -w @tmh/db",
    "db:studio": "npm run studio -w @tmh/db"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
